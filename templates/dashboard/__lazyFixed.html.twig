{% set theme =  getThemeProperties()  %}
{% for r in persistantRooms %}
    {% include 'dashboard/__roomCard.html.twig' with {'room':r} %}
{% endfor %}
{% if persistantHasMore and persistantLastRoomId %}
    <div class="lazyLoad" data-target="{{ path('dashboard_lazy',{'type':'fixed','lastRoomId':persistantLastRoomId}) }}">
        <div class="fa-3x text-center text-black-50"><i class="fas fa-spinner fa-spin"></i></div>
    </div>
{% endif %}
