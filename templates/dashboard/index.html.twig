{% extends 'base.html.twig' %}

{% block CTA %}

{% endblock %}

{% block pageContent %}
    <style>
        #dashboard-root {
            display: contents;
        }
    </style>
    <div id="dashboard-root"></div>
    <script id="dashboard-state" type="application/json">{{ dashboardState|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_QUOT'))|raw }}</script>
{% endblock %}

{% block javascripts %}
    <script>
        var topic = {{ mercure(['personal/'~app.user.uid])|json_encode(constant('JSON_UNESCAPED_SLASHES') b-or constant('JSON_HEX_TAG'))|raw }};
        var websocketTopics = "{{ getJwtforWebsocket(['personal/'~app.user.uid],app.user) }}";
        var websocketUrl = "{{ getUrlforWebsocket() }}";
    </script>
    {{ encore_entry_script_tags('dashboard') }}
{% endblock %}
