{% set theme =  getThemeProperties()  %}
{% for room in roomsPast %}
    {% include 'dashboard/__roomPast.html.twig' with {'room':room} %}
{% endfor %}
{% if pastHasMore and pastLastRoomId %}
    <div class="lazyLoad" data-target="{{ path('dashboard_lazy',{'type':'past','lastRoomId':pastLastRoomId}) }}">
        <div class="fa-3x text-center text-black-50"> <i class="fas fa-spinner fa-spin"></i></div>
    </div>
{% endif %}
